load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gofix_lib",
    srcs = ["main.go"],
    importpath = "golang.org/x/tools/internal/gofix/cmd/gofix",
    visibility = ["//visibility:private"],
    deps = [
        "//go/analysis/singlechecker",
        "//internal/gofix",
    ],
)

go_binary(
    name = "gofix",
    embed = [":gofix_lib"],
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)
