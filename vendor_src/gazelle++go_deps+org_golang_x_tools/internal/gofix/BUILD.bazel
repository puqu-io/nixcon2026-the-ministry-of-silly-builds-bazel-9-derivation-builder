load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gofix",
    srcs = [
        "doc.go",
        "gofix.go",
    ],
    embedsrcs = ["doc.go"],
    importpath = "golang.org/x/tools/internal/gofix",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
    deps = [
        "//go/analysis",
        "//go/analysis/passes/inspect",
        "//go/ast/edge",
        "//go/ast/inspector",
        "//go/types/typeutil",
        "//internal/analysisinternal",
        "//internal/diff",
        "//internal/gofix/findgofix",
        "//internal/refactor/inline",
        "//internal/typesinternal",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gofix",
    visibility = [
        "//:__subpackages__",
        "@org_golang_x_tools_go_vcs//:__subpackages__",
    ],
)

go_test(
    name = "gofix_test",
    srcs = ["gofix_test.go"],
    embed = [":gofix"],
    deps = [
        "//go/analysis/analysistest",
        "//internal/testenv",
        "@com_github_google_go_cmp//cmp",
    ],
)
